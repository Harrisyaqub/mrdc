---
import { content } from "../../data/content";
import { ui } from "../../data/translations";
import { href } from "../../data/site-config";
const { lang = "en" } = Astro.props;
const d = content[lang];
const ids = [
  "registration",
  "consultation",
  "casting",
  "fabrication",
  "fitting-gait-training",
  "fitting-gait-training",
  "final-checkout",
];
---

<section class="section protocol-summary">
  <div class="container">
    <h2 class="center-title">{ui[lang].protocol}</h2>
    <p class="section-intro">
      {d.home[20].blocks[0]?.text ||
        "The following guidelines are designed to help patients understand the typical steps involved in receiving prosthetic and orthotic rehabilitation services at MRDC."}
    </p>
    <ol class="protocol-circles">
      {ids.map((id, i) => (
        <li>
          <a href={`${href(lang, "patient-protocol")}#${id}`}>
            <span>
              {ui[lang].step} {i + 1}
            </span>
            <strong>{d.home[21 + i].blocks[0]?.text}</strong>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>
